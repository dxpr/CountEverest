{
  "name": "counteverest",
  "version": "3.0.0",
  "description": "A lightweight, customizable countdown script",
  "main": "dist/counteverest.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint:js": "eslint 'js/**/*.js'",
    "lint:js:fix": "eslint 'js/**/*.js' --fix",
    "lint:css": "stylelint 'scss/**/*.scss'",
    "lint:css:fix": "stylelint 'scss/**/*.scss' --fix",
    "lint:md": "markdownlint '**/*.md'",
    "lint:md:fix": "markdownlint '**/*.md' --fix",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "keywords": [
    "countdown",
    "timer",
    "vanilla-js"
  ],
  "author": "DXPR",
  "license": "GPL-2.0",
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-object-rest-spread": "^7.20.7",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-transform-object-rest-spread": "^7.24.7",
    "@babel/plugin-transform-private-methods": "^7.24.7",
    "@babel/preset-env": "^7.25.3",
    "autoprefixer": "^10.4.14",
    "babel-loader": "^9.1.2",
    "core-js": "^3.38.0",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^5.0.1",
    "eslint": "^8.43.0",
    "eslint-config-prettier": "^8.8.0",
    "husky": "^8.0.3",
    "lint-staged": "^13.2.2",
    "markdownlint": "^0.34.0",
    "markdownlint-cli": "^0.41.0",
    "mini-css-extract-plugin": "^2.7.6",
    "postcss": "^8.4.24",
    "postcss-loader": "^7.3.3",
    "prettier": "^2.8.8",
    "sass": "^1.63.6",
    "sass-loader": "^13.3.2",
    "stylelint": "^15.9.0",
    "stylelint-config-standard-scss": "^9.0.0",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not op_mini all"
  ],
  "lint-staged": {
    "*.js": "eslint --cache --fix",
    "*.scss": "stylelint --fix",
    "*.md": "markdownlint --fix",
    "*.{js,scss,md,json,html}": "prettier --write"
  }
}