{
  "name": "@dxpr/counteverest",
  "version": "3.1.0-beta3",
  "description": "A lightweight, customizable countdown script",
  "main": "dist/counteverest.js",
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "lint:js": "eslint 'js/**/*.js'",
    "lint:js:fix": "eslint 'js/**/*.js' --fix",
    "lint:css": "stylelint 'scss/**/*.scss'",
    "lint:css:fix": "stylelint 'scss/**/*.scss' --fix",
    "lint:md": "markdownlint '**/*.md'",
    "lint:md:fix": "markdownlint '**/*.md' --fix",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "keywords": [
    "countdown",
    "timer",
    "vanilla-js"
  ],
  "author": "DXPR",
  "license": "GPL-2.0",
  "devDependencies": {
    "@babel/core": "^7",
    "@babel/plugin-proposal-class-properties": "^7",
    "@babel/plugin-proposal-object-rest-spread": "^7",
    "@babel/plugin-proposal-private-methods": "^7",
    "@babel/plugin-transform-object-rest-spread": "^7",
    "@babel/plugin-transform-private-methods": "^7",
    "@babel/preset-env": "^7",
    "autoprefixer": "^10",
    "babel-loader": "^9",
    "core-js": "^3",
    "css-loader": "^7",
    "css-minimizer-webpack-plugin": "^7",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "husky": "^9",
    "lint-staged": "^15",
    "markdownlint": "^0",
    "markdownlint-cli": "^0",
    "mini-css-extract-plugin": "^2",
    "postcss": "^8",
    "postcss-loader": "^8",
    "postcss-pxtorem": "^6",
    "prettier": "^3",
    "sass": "^1",
    "sass-loader": "^16",
    "stylelint": "^16",
    "stylelint-config-standard-scss": "^13",
    "terser-webpack-plugin": "^5",
    "webpack": "^5",
    "webpack-cli": "^5",
    "webpack-dev-server": "^5"
  },
  "browserslist": [
    ">1%",
    "not dead",
    "not op_mini all"
  ],
  "lint-staged": {
    "!(dist)/**/*.js": "eslint --cache --fix",
    "*.scss": "stylelint --fix",
    "*.md": "markdownlint --fix",
    "*.{js,scss,md,json,html}": "prettier --write"
  }
}
